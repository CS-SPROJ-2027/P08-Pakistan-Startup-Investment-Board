# Copy this file to .env and fill in your own values
PORT=5000
CLIENT_URL=http://localhost:5173

# Option 1: local PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=psib

# Option 2: online database (Neon). If this is set, the DB_ values above are ignored.
DATABASE_URL=
DATABASE_SSL=false

# Secret used to sign login tokens. Use any long random text.
JWT_SECRET=
# How long a login lasts before the user has to log in again
JWT_EXPIRES_IN=8h

# Admin account created by npm run db:init
ADMIN_EMAIL=admin@psib.pk
ADMIN_PASSWORD=
